{
  "rules": {
    ".read": false,
    ".write": false,
    "circles": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['activeSession', 'joinedAt', 'device', 'timezone', 'x', 'y', 'viewportX', 'viewportY'])",
        "activeSession": {
          ".validate": "newData.isBoolean() && newData.val() === true"
        },
        "joinedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
        },
        "device": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "timezone": {
          ".validate": "newData.isString() && newData.val().matches(/^UTC[+-][0-9]+(\\.[0-9]+)?$/) && newData.val().length <= 12"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10"
        },
        "viewportX": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "viewportY": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
